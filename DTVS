
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>DTVS Quiz Challenge</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      padding: 50px 20px;
      background: #eef3f8;
    }

    .box {
      background: white;
      padding: 35px 20px;
      border-radius: 15px;
      max-width: 450px;
      margin: auto;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    h1 {
      color: #174b78;
    }

    p {
      font-size: 17px;
      line-height: 1.5;
    }

    button {
      background: #0875c9;
      color: white;
      border: none;
      padding: 16px 30px;
      border-radius: 8px;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #055a9c;
    }
  </style>
</head>

<body>
  <div class="box">
    <h1>DTVS QUIZ CHALLENGE</h1>
    <p>Welcome!</p>
    <p>Click below to start your randomly assigned quiz.</p>
    <button onclick="startQuiz()">START MY QUIZ</button>
  </div>

  <script>
    const quizLinks = [
      "https://forms.cloud.microsoft/r/5ZEK2apY4r?origin=lprLink",
      "https://forms.cloud.microsoft/r/mztZip8YYG?origin=lprLinkK",
      "https://forms.cloud.microsoft/r/TARh1TaN27?origin=lprLink",
      "https://forms.cloud.microsoft/r/pDWFCYDUKQ?origin=lprLink",
      "https://forms.cloud.microsoft/r/U1KUa143rd?origin=lprLink"
    ];

    function startQuiz() {
      const randomIndex = Math.floor(Math.random() * quizLinks.length);
      window.location.href = quizLinks[randomIndex];
    }
  </script>
</body>
</html>
